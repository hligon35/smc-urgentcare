{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smc-urgentcare",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "sandbox"
  },
  "env": {
    "sandbox": {
      "name": "smc-urgentcare",
      "vars": {
        "ENVIRONMENT": "sandbox"
      },
      "d1_databases": [
        {
          "binding": "",
          "database_name": "smc-sandbox",
          "database_id": "ab638b4b-b5b5-4376-a705-cf18729bb6a8",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "smc-urgentcare",
      "vars": {
      "AUTH_ALLOWED_ORIGINS": "https://smc-urgentcare.com",
      "AUTH_ORIGIN": "https://smcuc.alphazonelabs.com",
      "ENVIRONMENT": "production",
      "RESEND_FROM": "testing@smcuc.alphazonelabs.com",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFa2g5YSlEYZhv83"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "smc-db",
          "database_id": "a0683519-7e25-432c-80b7-dc9f7a231412",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "smc-sandbox",
      "database_id": "ab638b4b-b5b5-4376-a705-cf18729bb6a8",
      "migrations_dir": "migrations"
    }
  ]
}
