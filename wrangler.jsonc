{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smc-urgentcare-sandbox",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "sandbox"
  },
  "env": {
    "sandbox": {
      "name": "smc-urgentcare-sandbox",
      "vars": {
        "ENVIRONMENT": "sandbox"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "smc-portal-auth-sandbox",
          "database_id": "REPLACE_WITH_SANDBOX_D1_ID",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "smc-urgentcare",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "smc-portal-auth",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "smc-portal-auth-sandbox",
      "database_id": "REPLACE_WITH_SANDBOX_D1_ID",
      "migrations_dir": "migrations"
    }
  ]
}
