{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smc-urgentcare-production",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "AUTH_ALLOWED_ORIGINS": "https://smcurgentcareindy.com",
    "AUTH_ORIGIN": "https://smcurgentcareindy.com",
    "ENVIRONMENT": "production",
    "GOOGLE_CLIENT_ID": "622947551355-rl251sgg3e49i05p5j5gcifau3tucope.apps.googleusercontent.com",
    "RESEND_FROM": "testing@smcuc.alphazonelabs.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFa2g5YSlEYZhv83"
  },
  "env": {
    "sandbox": {
      "name": "smc-urgentcare",
      "vars": {
        "ENVIRONMENT": "sandbox",
        "AUTH_ORIGIN": "https://smc-urgentcare.hligon.workers.dev",
        "AUTH_ALLOWED_ORIGINS": "https://smc-urgentcare.hligon.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "smc-sandbox",
          "database_id": "ab638b4b-b5b5-4376-a705-cf18729bb6a8",
          "migrations_dir": "migrations"
        }
      ],
      "workers_dev": true
    },
    "production": {
      "name": "smc-urgentcare-production",
      "vars": {
        "AUTH_ALLOWED_ORIGINS": "https://smcurgentcareindy.com",
        "AUTH_ORIGIN": "https://smcurgentcareindy.com",
        "ENVIRONMENT": "production",
        "GOOGLE_CLIENT_ID": "622947551355-rl251sgg3e49i05p5j5gcifau3tucope.apps.googleusercontent.com",
        "RESEND_FROM": "testing@smcuc.alphazonelabs.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFa2g5YSlEYZhv83"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "smc-db",
          "database_id": "a0683519-7e25-432c-80b7-dc9f7a231412",
          "migrations_dir": "migrations"
        }
      ],
      "workers_dev": true,
      "routes": [
        {
          "pattern": "smcurgentcareindy.com",
          "custom_domain": true
        },
        {
          "pattern": "www.smcurgentcareindy.com",
          "custom_domain": true
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "smc-db",
      "database_id": "a0683519-7e25-432c-80b7-dc9f7a231412",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "smcurgentcareindy.com",
      "custom_domain": true
    },
    {
      "pattern": "www.smcurgentcareindy.com",
      "custom_domain": true
    }
  ]
}

