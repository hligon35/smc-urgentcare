# Public sandbox build configuration only. Run npm run env:init to create local files.
EXPO_PUBLIC_SITE_URL=https://smc-urgentcare-sandbox.hligon.workers.dev

# Runtime nonsecret settings live in wrangler.jsonc under env.sandbox.vars.
# Local secrets belong in .dev.vars.sandbox and are separate from production.
# Set the matching sandbox TURNSTILE_SITE_KEY in Wrangler when ready.
# Local .env/.dev.vars files never deploy Cloudflare secrets.
