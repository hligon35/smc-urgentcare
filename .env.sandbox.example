# Build-time public sandbox URL. Copy to .env.sandbox (gitignored).
EXPO_PUBLIC_SITE_URL=https://smc-urgentcare-sandbox.hligon.workers.dev

# Sandbox is a separate Worker with separate contact secrets and rate limits.
# Set an approved test destination only after verifying it in Email Routing:
# npx wrangler secret put CONTACT_TO --env sandbox
# npx wrangler secret put TURNSTILE_SECRET_KEY --env sandbox
# Configure the sandbox TURNSTILE_SITE_KEY in wrangler.jsonc.
# Runtime secrets are not deployed from this .env file.
