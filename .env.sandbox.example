# SMC Urgent Care - sandbox environment template
# Copy to .env.sandbox (gitignored). Sandbox uses the hligon.workers.dev hostname.
# Confirm that the Cloudflare account's Workers subdomain is hligon before deployment.
#
# Public Expo build-time configuration (safe to bundle in web/mobile clients).
EXPO_PUBLIC_SITE_URL=https://smc-urgentcare-sandbox.hligon.workers.dev
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=

# Cloudflare Worker runtime configuration (server-only; no EXPO_PUBLIC_ prefix).
# Set to the SAME sandbox HTTPS origin as EXPO_PUBLIC_SITE_URL.
AUTH_ORIGIN=https://smc-urgentcare-sandbox.hligon.workers.dev
AUTH_ALLOWED_ORIGINS=https://smc-urgentcare-sandbox.hligon.workers.dev

# Unique strong random sandbox value; never share the production pepper.
AUTH_PEPPER=
TURNSTILE_SECRET_KEY=

# Separate Google OAuth Web client for sandbox (callback:
# https://YOUR-SANDBOX-HOST/api/portal/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend sandbox sender for verification and recovery mail only; no PHI.
# Example format after verifying a domain: SMC CareConnect <no-reply@your-verified-domain>
RESEND_API_KEY=
RESEND_FROM=

# Runtime bindings managed by wrangler.jsonc, NOT ordinary .env strings:
# ENVIRONMENT=sandbox (set in env.sandbox.vars)
# AUTH_DB -> smc-sandbox D1 (set env.sandbox.d1_databases.database_id)
#
# The build script reads .env.sandbox; deployed Worker secrets must
# ALSO be set using 'npx wrangler secret put NAME --env sandbox'
# (or approved Cloudflare secret management). .env files aren't deployed as secrets.
