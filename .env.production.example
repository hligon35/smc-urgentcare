# SMC Urgent Care - production environment template
# Copy to .env.production (gitignored) and supply real values locally.
# NEVER commit passwords, OAuth client secrets, Resend API keys, or AUTH_PEPPER.
#
# Public Expo build-time configuration (safe to bundle in web/mobile clients).
EXPO_PUBLIC_SITE_URL=https://smcuc.alphazonelabs.com
# Production build also supports https://smc-urgentcare.com for future cutover.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Worker runtime configuration (server-only; no EXPO_PUBLIC_ prefix).
# AUTH_ORIGIN must exactly match the production HTTPS origin for login, cookies, and Google OAuth.
AUTH_ORIGIN=https://smcuc.alphazonelabs.com
AUTH_ALLOWED_ORIGINS=https://smc-urgentcare.com

# Generate a strong, random, unique value; changing it invalidates accounts/sessions.
AUTH_PEPPER=
TURNSTILE_SECRET_KEY=

# Google OAuth 2.0 Web client (callback:
# https://smcuc.alphazonelabs.com/api/portal/auth/google/callback
# Also authorize https://smc-urgentcare.com/api/portal/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend: domain-verified sender; verification and recovery email only, no PHI.
# Example format after verifying a domain: SMC CareConnect <no-reply@your-verified-domain>
RESEND_API_KEY=
RESEND_FROM=

# Runtime bindings managed by wrangler.jsonc, NOT ordinary .env strings:
# ENVIRONMENT=production (set in env.production.vars)
# AUTH_DB -> smc-portal-auth D1 (set env.production.d1_databases.database_id)
#
# The build script reads .env.production; deployed Worker secrets must
# ALSO be set using 'npx wrangler secret put NAME --env production'
# (or approved Cloudflare secret management). .env files aren't deployed as secrets.
