# Build-time public canonical URL. Copy to .env.production (gitignored).
EXPO_PUBLIC_SITE_URL=https://smcurgentcareindy.com

# Runtime values are managed separately in wrangler.jsonc / Cloudflare secrets.
# CONTACT_FROM and TURNSTILE_SITE_KEY are Worker vars.
# Once the recipient is named and verified in Cloudflare Email Routing:
# npx wrangler secret put CONTACT_TO --env production
# npx wrangler secret put TURNSTILE_SECRET_KEY --env production
# Do not put recipients or private keys in EXPO_PUBLIC_* variables.
# No custom patient accounts, D1 bindings, OAuth clients or Resend keys are required.
