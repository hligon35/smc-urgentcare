# Public build configuration only. Run npm run env:init to create ignored local files.
# Exactly one canonical HTTPS origin; never a comma-separated list.
EXPO_PUBLIC_SITE_URL=https://smcurgentcareindy.com

# Runtime nonsecret settings live in wrangler.jsonc under env.production.vars:
# ENVIRONMENT, SITE_ORIGIN, CONTACT_ALLOWED_ORIGINS, CONTACT_FROM, TURNSTILE_SITE_KEY.
# Local secrets belong in .dev.vars.production; deploy secrets with Wrangler.
# Do not add account/OAuth/Resend/D1 variables or private EXPO_PUBLIC_* values.
