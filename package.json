{
  "name": "smc-urgentcare",
  "version": "1.0.0",
  "description": "SMC Urgent Care — Expo web and mobile, deployed to Cloudflare Workers",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs production",
    "build:mobile": "expo export --platform ios --platform android --output-dir dist-native",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-build.mjs",
    "preview": "wrangler dev --env sandbox",
    "deploy:sandbox": "npm run build:sandbox && wrangler deploy --env sandbox",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "verify:build": "node scripts/check-build.mjs",
    "build:sandbox": "node scripts/build.mjs sandbox",
    "deploy:dry-run": "npm run build && wrangler deploy --env production --dry-run",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run deploy:production",
    "auth:check:production": "node scripts/check-auth.mjs",
    "db:migrate:production": "wrangler d1 migrations apply smc-db --env production --remote",
    "sample-user:password": "node scripts/set-sample-password.mjs"
  },
  "keywords": [],
  "dependencies": {
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "~19.2.3",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
